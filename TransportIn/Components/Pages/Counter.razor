@page "/counter"
@layout TransportIn.Components.Layout.AdminLayout
@rendermode InteractiveServer
@inject TransportIn.Services.AuthService AuthService
@inject NavigationManager Navigation

<div class="admin-layout">
    <!-- ===== САЙДБАР ===== -->
    <aside class="admin-sidebar">
        <div class="sidebar-header">
            <h4><i class="bi bi-truck-front-fill"></i> TransportIn</h4>
            <small>Диспетчерський пульт</small>
        </div>
        <nav class="mt-3">
            @if (AuthService.CurrentUser?.Role == TransportIn.Models.UserRole.Admin)
            {
                <a class="nav-link @(IsActive("/admin-dashboard") ? "active" : "")" href="/admin-dashboard"><i class="bi bi-grid-1x2-fill"></i> Панель адміна</a>
            }
            @if (AuthService.CurrentUser?.Role == TransportIn.Models.UserRole.Manager)
            {
                <a class="nav-link @(IsActive("/manager-dashboard") ? "active" : "")" href="/manager-dashboard"><i class="bi bi-people-fill"></i> Менеджер</a>
            }
            @if (AuthService.CurrentUser?.Role == TransportIn.Models.UserRole.Driver)
            {
                <a class="nav-link @(IsActive("/driver-dashboard") ? "active" : "")" href="/driver-dashboard"><i class="bi bi-person-badge-fill"></i> Водій</a>
            }
            <a class="nav-link @(IsActive("/map-monitor") ? "active" : "")" href="/map-monitor"><i class="bi bi-map"></i> Карта моніторингу</a>
            @if (AuthService.CurrentUser?.Role != TransportIn.Models.UserRole.Driver)
            {
                <a class="nav-link @(IsActive("/history") ? "active" : "")" href="/history"><i class="bi bi-clock-history"></i> Історія</a>
            }
            <a class="nav-link @(IsActive("/counter") ? "active" : "")" href="/counter"><i class="bi bi-graph-up-arrow"></i> Аналітика</a>
        </nav>
    </aside>

    <!-- ===== ОСНОВНИЙ КОНТЕНТ ===== -->
    <main class="admin-main">
        <!-- Верхня панель -->
        <div class="top-navbar">
            <div>
                <h5 class="mb-0" style="font-weight: 600; color: var(--text-primary);">Системна аналітика</h5>
                <small style="color: var(--text-secondary);">Моніторинг активності в реальному часі</small>
            </div>
            <div class="user-info">
                <div class="text-end d-none d-sm-block">
                    <div class="user-name">@AuthService.CurrentUser?.FullName</div>
                    <div class="user-role">@AuthService.CurrentUser?.Role</div>
                </div>
                <div class="user-avatar">@GetInitials(AuthService.CurrentUser?.FullName)</div>
            </div>
        </div>

        <div class="content-section">
            <!-- Головна картка з лічильником -->
            <div class="stats-row">
                <div class="stat-card" style="grid-column: 1 / -1; align-items: center; padding: 2rem;">
                    <div class="stat-icon blue" style="width: 64px; height: 64px; font-size: 2rem; flex-shrink: 0;">
                        <i class="bi bi-cpu"></i>
                    </div>
                    <div class="ms-4 text-center text-sm-start">
                        <div class="stat-value" style="font-size: 3.5rem; line-height: 1;">@currentCount</div>
                        <div class="stat-label" style="font-size: 1rem; margin-top: 0.5rem;">Оброблено системних операцій</div>
                    </div>
                    <div class="ms-auto">
                        <button class="btn-modern btn-add" @onclick="IncrementCount" style="height: 52px; padding: 0 2rem; font-size: 1rem;">
                            <i class="bi bi-plus-lg"></i> Імітувати операцію
                        </button>
                    </div>
                </div>
            </div>

            <!-- Додаткові декоративні картки для наповненості інтерфейсу -->
            <div class="stats-row">
                <div class="stat-card">
                    <div class="stat-icon green"><i class="bi bi-check-circle"></i></div>
                    <div>
                        <div class="stat-value">99.9%</div>
                        <div class="stat-label">Час безвідмовної роботи</div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon amber"><i class="bi bi-lightning-charge"></i></div>
                    <div>
                        <div class="stat-value">12 мс</div>
                        <div class="stat-label">Час відгуку сервера</div>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon blue"><i class="bi bi-people"></i></div>
                    <div>
                        <div class="stat-value">4</div>
                        <div class="stat-label">Активних користувачів</div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>

@code {
    private int currentCount = 0;

    private void IncrementCount()
    {
        currentCount++;
    }

    private bool IsActive(string path) => Navigation.Uri.EndsWith(path, StringComparison.OrdinalIgnoreCase);

    private string GetInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length >= 2 ? $"{parts[0][0]}{parts[1][0]}".ToUpper() : name[..Math.Min(2, name.Length)].ToUpper();
    }
}