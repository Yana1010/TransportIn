@page "/driver-dashboard"
@layout TransportIn.Components.Layout.AdminLayout
@rendermode InteractiveServer
@inject TransportIn.Services.AuthService AuthService
@inject TransportIn.Services.EmergencyService EmergencyService
@inject TransportIn.Services.OrderService OrderService
@implements IDisposable
@inject NavigationManager Navigation

<div class="admin-layout">
    <aside class="admin-sidebar">
        <div class="sidebar-header">
            <h4><i class="bi bi-truck-front-fill"></i> TransportIn</h4>
            <small>Диспетчерський пульт</small>
        </div>
        <nav class="mt-3">
            @if (AuthService.CurrentUser?.Role == TransportIn.Models.UserRole.Admin)
            {
                <a class="nav-link @(IsActive("/admin-dashboard") ? "active" : "")" href="/admin-dashboard"><i class="bi bi-grid-1x2-fill"></i> Панель адміна</a>
            }
            @if (AuthService.CurrentUser?.Role == TransportIn.Models.UserRole.Manager)
            {
                <a class="nav-link @(IsActive("/manager-dashboard") ? "active" : "")" href="/manager-dashboard"><i class="bi bi-people-fill"></i> Менеджер</a>
            }
            @if (AuthService.CurrentUser?.Role == TransportIn.Models.UserRole.Driver)
            {
                <a class="nav-link @(IsActive("/driver-dashboard") ? "active" : "")" href="/driver-dashboard"><i class="bi bi-person-badge-fill"></i> Водій</a>
            }
            <a class="nav-link @(IsActive("/map-monitor") ? "active" : "")" href="/map-monitor"><i class="bi bi-map"></i> Карта моніторингу</a>
            @if (AuthService.CurrentUser?.Role != TransportIn.Models.UserRole.Driver)
            {
                <a class="nav-link @(IsActive("/history") ? "active" : "")" href="/history"><i class="bi bi-clock-history"></i> Історія</a>
            }
            <a class="nav-link @(IsActive("/counter") ? "active" : "")" href="/counter"><i class="bi bi-graph-up-arrow"></i> Аналітика</a>
        </nav>
    </aside>

    <main class="admin-main">
        <div class="top-navbar">
            <div>
                <h5 class="mb-0" style="font-weight:600;color:var(--text-primary);">Кабінет водія</h5>
                <small style="color:var(--text-secondary);">@AuthService.CurrentUser?.FullName</small>
            </div>
            <div class="user-info">
                <button class="btn-logout" @onclick="Logout"><i class="bi bi-box-arrow-right"></i> <span class="d-none d-sm-inline">Вийти</span></button>
            </div>
        </div>

        <div class="content-section">
            <!-- ПОВІДОМЛЕННЯ ПРО ЗАГРОЗИ -->
            @if (!string.IsNullOrEmpty(EmergencyService.CurrentEmergency) && EmergencyService.CurrentEmergency != "Спокійно")
            {
                <div class="threat-alert-driver @(GetThreatClass())">
                    <div class="threat-title">
                        <i class="bi @GetThreatIcon()"></i>
                        Увага! @EmergencyService.CurrentEmergency
                    </div>
                    <div class="threat-body">@GetThreatAdvice()</div>
                </div>
            }

            @if (currentOrder == null)
            {
                <!-- Порожній стан: немає призначених замовлень -->
                <div class="modern-card">
                    <div class="card-body-custom">
                        <div class="empty-state">
                            <i class="bi bi-truck"></i>
                            <h4>Немає активних замовлень</h4>
                            <p>Наразі вам не призначено жодного замовлення. Після призначення менеджером воно з'явиться тут.</p>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="driver-grid">
                    <!-- ===== ЛІВА КОЛОНКА: ДЕТАЛІ + СТАДІЇ ===== -->
                    <div>
                        <!-- Деталі замовлення -->
                        <div class="modern-card mb-4">
                            <div class="card-header-custom">
                                <h5><span class="header-icon blue"><i class="bi bi-box-seam"></i></span> Замовлення №@currentOrder.Id</h5>
                                <span class="status-badge @DriverStatusClass(currentOrder.Status)">@currentOrder.Status</span>
                            </div>
                            <div class="card-body-custom">
                                <div class="order-detail-grid">
                                    <div class="detail-block">
                                        <div class="detail-block-title"><i class="bi bi-building"></i> Замовник</div>
                                        <div class="detail-block-value">@currentOrder.CustomerCompany</div>
                                        <div class="detail-block-sub">@currentOrder.CustomerName · @currentOrder.CustomerPhone</div>
                                    </div>
                                    <div class="detail-block">
                                        <div class="detail-block-title"><i class="bi bi-truck"></i> Транспортний засіб</div>
                                        <div class="detail-block-value">@currentOrder.VehicleModel</div>
                                        <div class="detail-block-sub">Держномер: @currentOrder.VehiclePlate</div>
                                    </div>
                                    <div class="detail-block">
                                        <div class="detail-block-title"><i class="bi bi-box"></i> Вантаж</div>
                                        <div class="detail-block-value">@currentOrder.CargoName</div>
                                        <div class="detail-block-sub">
                                            Вага: @currentOrder.WeightTons т · Об'єм: @currentOrder.VolumeM3 м³
                                            @if (currentOrder.NeedsRefrigerator)
                                            {
                                                <span style="color:#60a5fa">❄️ рефрижератор</span>
                                            }
                                        </div>
                                    </div>
                                    <div class="detail-block">
                                        <div class="detail-block-title"><i class="bi bi-geo-alt"></i> Маршрут</div>
                                        <div class="detail-block-value">@currentOrder.Points.Count точок</div>
                                        <div class="detail-block-sub">Загальна відстань: ~@currentOrder.TotalDistance км · Час: ~@currentOrder.TotalTime хв</div>
                                    </div>
                                </div>

                                <!-- Точки маршруту -->
                                <div class="mt-3">
                                    <div class="detail-block-title" style="margin-bottom:.5rem"><i class="bi bi-signpost-2"></i> Пункти маршруту</div>
                                    @for (int i = 0; i < currentOrder.Points.Count; i++)
                                    {
                                        var p = currentOrder.Points[i];
                                        <div class="stage-row @(i < currentOrder.CompletedPoints ? "done" : (i == currentOrder.CompletedPoints ? "active" : "pending"))">
                                            <div class="stage-icon">
                                                @if (i < currentOrder.CompletedPoints)
                                                {
                                                    <i class="bi bi-check-lg"></i>
                                                }
                                                else if (i == currentOrder.CompletedPoints)
                                                {
                                                    <i class="bi bi-hourglass-split"></i>
                                                }
                                                else
                                                {
                                                    <span style="font-size:.75rem;font-weight:700">@(i + 1)</span>
                                                }
                                            </div>
                                            <div style="flex-grow:1">
                                                <div class="stage-label">
                                                    <span class="point-type-badge @(p.IsLoading ? "loading" : "delivery")" style="font-size:.65rem;padding:.1rem .35rem;margin-right:.4rem">
                                                        @(p.IsLoading ? "ЗАВАНТАЖ." : "ДОСТАВКА")
                                                    </span>
                                                    @p.Address
                                                </div>
                                                <div class="stage-time">
                                                    <i class="bi bi-person me-1"></i>@p.ContactName · <i class="bi bi-telephone me-1"></i>@p.ContactPhone
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Стадії виконання -->
                        <div class="modern-card">
                            <div class="card-header-custom">
                                <h5><span class="header-icon green"><i class="bi bi-check2-square"></i></span> Стадії виконання</h5>
                            </div>
                            <div class="card-body-custom">
                                <div class="stages-timeline">
                                    @foreach (var s in stages)
                                    {
                                        <div class="stage-row @s.StateClass">
                                            <div class="stage-icon">
                                                @if (s.State == "done")
                                                {
                                                    <i class="bi bi-check-lg"></i>
                                                }
                                                else if (s.State == "active")
                                                {
                                                    <i class="bi bi-hourglass-split"></i>
                                                }
                                                else if (s.State == "blocked")
                                                {
                                                    <i class="bi bi-lock-fill"></i>
                                                }
                                                else
                                                {
                                                    <span style="font-size:.7rem;font-weight:700">@s.Number</span>
                                                }
                                            </div>
                                            <div class="stage-label">@s.Label</div>
                                            @if (!string.IsNullOrEmpty(s.Time))
                                            {
                                                <div class="stage-time">@s.Time</div>
                                            }
                                        </div>
                                    }
                                </div>

                                <!-- Кнопки дій -->
                                <div class="stage-actions">
                                    @if (currentStageIndex < stages.Count && stages[currentStageIndex].State == "active" && !isBlockedByThreat)
                                    {
                                        <button class="btn-stage primary" @onclick="ConfirmStage">
                                            <i class="bi bi-check-circle-fill"></i> @stages[currentStageIndex].ButtonLabel
                                        </button>
                                    }
                                    @if (isBlockedByThreat)
                                    {
                                        <div class="threat-alert-driver danger" style="margin-top:1rem;width:100%">
                                            <div class="threat-title"><i class="bi bi-exclamation-triangle-fill"></i> Рух заблоковано</div>
                                            <div class="threat-body">Через @EmergencyService.CurrentEmergency виїзд/продовження руху тимчасово заблоковано згідно з протоколом безпеки. Очікуйте повідомлення від диспетчера.</div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ===== ПРАВА КОЛОНКА: КАРТА + ПОВІДОМЛЕННЯ ===== -->
                    <div>
                        <!-- Карта маршруту -->
                        <div class="modern-card mb-4">
                            <div class="card-header-custom">
                                <h5><span class="header-icon blue"><i class="bi bi-map"></i></span> Мій маршрут</h5>
                            </div>
                            <div class="card-body-custom p-0">
                                <div class="map-placeholder-sm">
                                    <div class="placeholder-content">
                                        <i class="bi bi-map-fill"></i>
                                        <h5>Карта маршруту</h5>
                                        <p>Тут буде інтерактивна карта з вашим маршрутом та поточним положенням ТЗ</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Повідомлення про проблеми -->
                        <div class="modern-card">
                            <div class="card-header-custom">
                                <h5><span class="header-icon" style="background:rgba(239,68,68,.15);color:#f87171"><i class="bi bi-exclamation-triangle"></i></span> Повідомити про проблему</h5>
                            </div>
                            <div class="card-body-custom">
                                <div class="form-section-title"><i class="bi bi-tag"></i> Тип проблеми</div>
                                <div class="problem-type-btns">
                                    <button class="problem-type-btn @(problemCategory == "admin" ? "selected" : "")" @onclick='() => problemCategory = "admin"'>
                                        <i class="bi bi-shield-exclamation d-block mb-1"></i>
                                        ДТП / дорога
                                        <div style="font-size:.68rem;font-weight:400;opacity:.7;margin-top:.2rem">→ Адміністратору</div>
                                    </button>
                                    <button class="problem-type-btn @(problemCategory == "manager" ? "selected" : "")" @onclick='() => problemCategory = "manager"'>
                                        <i class="bi bi-person-x d-block mb-1"></i>
                                        Клієнт / вантаж
                                        <div style="font-size:.68rem;font-weight:400;opacity:.7;margin-top:.2rem">→ Менеджеру</div>
                                    </button>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label-modern">Тема *</label>
                                    <input class="dark-input w-100 @ProblemErr("Subject")" @bind="problemSubject" placeholder="Коротко опишіть проблему" />
                                    @ProblemMsg("Subject")
                                </div>
                                <div class="mb-3">
                                    <label class="form-label-modern">Опис *</label>
                                    <textarea class="dark-input w-100 @ProblemErr("Body")" rows="4" @bind="problemBody" placeholder="Детально опишіть ситуацію, місце, обставини..."></textarea>
                                    @ProblemMsg("Body")
                                </div>

                                @if (problemSent)
                                {
                                    <div class="form-banner-error" style="background:rgba(16,185,129,.1);border-color:rgba(16,185,129,.3);color:#34d399">
                                        <i class="bi bi-check-circle-fill"></i> Повідомлення успішно надіслано відповідальній стороні!
                                    </div>
                                }

                                <button class="btn-modern w-100" style="background:var(--danger-red);color:white;height:44px" @onclick="SendProblemReport">
                                    <i class="bi bi-send"></i> Надіслати диспетчеру
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </main>
</div>

@code {
    private OrderVM? currentOrder;
    private List<StageVM> stages = new();
    private int currentStageIndex = 0;
    private bool isBlockedByThreat = false;

    private string problemCategory = "admin";
    private string problemSubject = "";
    private string problemBody = "";
    private bool problemSent = false;
    private Dictionary<string, string> problemErrors = new();

    private class OrderVM
    {
        public int Id; public string CustomerCompany = ""; public string CustomerName = ""; public string CustomerPhone = "";
        public string VehicleModel = ""; public string VehiclePlate = "";
        public string CargoName = ""; public double WeightTons; public double VolumeM3; public bool NeedsRefrigerator;
        public int TotalDistance; public int TotalTime;
        public string Status = "Призначено";
        public List<PointVM> Points = new();
        public int CompletedPoints;
    }

    private class PointVM
    {
        public bool IsLoading; public string Address = ""; public string ContactName = ""; public string ContactPhone = ""; public string OperationType = "";
    }

    private class StageVM
    {
        public int Number; public string Label = ""; public string ButtonLabel = ""; public string State = "pending"; public string Time = "";
        public string StateClass => State;
    }

    protected override void OnInitialized()
    {
        var userRole = AuthService.CurrentUser?.Role;
        if (userRole != TransportIn.Models.UserRole.Driver)
        {
            Navigation.NavigateTo(GetRedirectPath(userRole));
            return;
        }

        EmergencyService.OnChange += OnEmergencyChanged;
        OrderService.OnChange += OnOrderChanged;
        CheckThreatBlock();
        LoadCurrentOrder();
        InitStages();
    }

    private void OnEmergencyChanged()
    {
        CheckThreatBlock();
        InvokeAsync(StateHasChanged);
    }

    private void OnOrderChanged()
    {
        LoadCurrentOrder();
        InvokeAsync(StateHasChanged);
    }

    private void LoadCurrentOrder()
    {
        // Беремо актуальне замовлення з сервісу (яке підключене до БД або сховища)
        var dbOrder = OrderService.GetAllOrders().FirstOrDefault(o => o.Status != "Завершено");

        if (dbOrder != null)
        {
            var points = new List<PointVM>();
            foreach (var lp in dbOrder.LoadingPoints)
                points.Add(new PointVM { IsLoading = true, Address = lp, ContactName = dbOrder.CustomerName, ContactPhone = dbOrder.CustomerPhone, OperationType = "Завантаження" });
            foreach (var dp in dbOrder.DeliveryPoints)
                points.Add(new PointVM { IsLoading = false, Address = dp, ContactName = dbOrder.CustomerName, ContactPhone = dbOrder.CustomerPhone, OperationType = "Доставка" });

            currentOrder = new OrderVM
            {
                Id = dbOrder.Id,
                CustomerCompany = dbOrder.CustomerCompany,
                CustomerName = dbOrder.CustomerName,
                CustomerPhone = dbOrder.CustomerPhone,
                VehicleModel = "Призначений ТЗ",
                VehiclePlate = dbOrder.AssignedVehiclePlate,
                CargoName = dbOrder.CargoName,
                WeightTons = dbOrder.WeightTons,
                VolumeM3 = dbOrder.VolumeM3,
                NeedsRefrigerator = dbOrder.RequiresRefrigerator,
                TotalDistance = 35,
                TotalTime = 70,
                Status = dbOrder.Status,
                CompletedPoints = 0,
                Points = points
            };
        }
        else
        {
            currentOrder = null;
        }
    }

    private void InitStages()
    {
        if (currentOrder == null) return;

        stages = new()
        {
            new() { Number = 1, Label = "Прибув на пункт завантаження", ButtonLabel = "Підтвердити прибуття", State = "active" },
            new() { Number = 2, Label = "Початок завантаження", ButtonLabel = "Почати завантаження", State = "pending" },
            new() { Number = 3, Label = "Завершення завантаження", ButtonLabel = "Завершити завантаження", State = "pending" },
            new() { Number = 4, Label = "Виїзд / в дорозі", ButtonLabel = "Підтвердити виїзд", State = "pending" },
            new() { Number = 5, Label = "Прибув на пункт доставки", ButtonLabel = "Прибув на розвантаження", State = "pending" },
            new() { Number = 6, Label = "Початок розвантаження", ButtonLabel = "Почати розвантаження", State = "pending" },
            new() { Number = 7, Label = "Завершення розвантаження", ButtonLabel = "Завершити розвантаження", State = "pending" },
            new() { Number = 8, Label = "Замовлення завершено", ButtonLabel = "Завершити замовлення", State = "pending" }
        };
        currentStageIndex = 0;
    }

    private void CheckThreatBlock()
    {
        isBlockedByThreat = EmergencyService.CurrentEmergency switch
        {
            "Повітряна тривога" => true,
            "Перекриття мостів" => true,
            _ => false
        };
    }

    private void ConfirmStage()
    {
        if (currentOrder == null || currentStageIndex >= stages.Count || isBlockedByThreat) return;

        stages[currentStageIndex].State = "done";
        stages[currentStageIndex].Time = DateTime.Now.ToString("HH:mm");

        var label = stages[currentStageIndex].Label.ToLower();
        if (label.Contains("завершення завантаження") || label.Contains("завершення розвантаження"))
        {
            currentOrder.CompletedPoints++;
        }

        // Синхронізація статусу з OrderService (БД)
        var dbOrder = OrderService.GetAllOrders().FirstOrDefault(o => o.Id == currentOrder.Id);

        currentStageIndex++;
        if (currentStageIndex < stages.Count)
        {
            stages[currentStageIndex].State = "active";
            currentOrder.Status = "В дорозі";
            if (dbOrder != null) dbOrder.Status = "В дорозі";
        }
        else
        {
            currentOrder.Status = "Завершено";
            if (dbOrder != null) dbOrder.Status = "Завершено";
        }
        StateHasChanged();
    }

    private void SendProblemReport()
    {
        problemErrors.Clear();
        if (string.IsNullOrWhiteSpace(problemSubject)) problemErrors["Subject"] = "Обов'язкове поле";
        if (string.IsNullOrWhiteSpace(problemBody) || problemBody.Length < 10) problemErrors["Body"] = "Мінімум 10 символів";

        if (problemErrors.Count > 0) { StateHasChanged(); return; }

        problemSent = true;
        problemSubject = "";
        problemBody = "";
        StateHasChanged();
    }

    private string ProblemErr(string k) => problemErrors.ContainsKey(k) ? "is-invalid" : "";
    private RenderFragment ProblemMsg(string k) => builder =>
    {
        if (problemErrors.TryGetValue(k, out var m))
        {
            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "class", "invalid-feedback-modern");
            builder.AddContent(2, "⚠ " + m);
            builder.CloseElement();
        }
    };

    private string GetThreatClass() => EmergencyService.CurrentEmergency switch
    {
        "Повітряна тривога" => "danger",
        "Ожеледиця" or "Перекриття мостів" => "",
        _ => "calm"
    };

    private string GetThreatIcon() => EmergencyService.CurrentEmergency switch
    {
        "Повітряна тривога" => "bi-exclamation-triangle-fill",
        "Ожеледиця" => "bi-snow2",
        "Перекриття мостів" => "bi-sign-stop-fill",
        _ => "bi-info-circle-fill"
    };

    private string GetThreatAdvice() => EmergencyService.CurrentEmergency switch
    {
        "Повітряна тривога" => "Згідно з протоколом безпеки: якщо ви на пункті — залишайтеся та очікуйте. Якщо в дорозі — рухайтеся до найближчого безпечного місця очікування.",
        "Ожеледиця" => "Зменшіть швидкість на 30-50%. Увімкніть протитуманні фари. Збільште дистанцію.",
        "Перекриття мостів" => "Увага! Всі мостові переходи перекриті. Побудова маршруту через річку неможлива. Очікуйте відновлення руху.",
        _ => "Дотримуйтесь інструкцій диспетчера."
    };

    private string DriverStatusClass(string s) => s switch
    {
        "Призначено" => "new",
        "В дорозі" => "in-progress",
        "Призупинено" => "suspended",
        "Завершено" => "completed",
        _ => "new"
    };

    private void Logout()
    {
        AuthService.Logout();
        Navigation.NavigateTo("/");
    }

    private bool IsActive(string path) => Navigation.Uri.EndsWith(path, StringComparison.OrdinalIgnoreCase);

    private string GetRedirectPath(TransportIn.Models.UserRole? role) => role switch
    {
        TransportIn.Models.UserRole.Admin => "/admin-dashboard",
        TransportIn.Models.UserRole.Manager => "/manager-dashboard",
        TransportIn.Models.UserRole.Driver => "/driver-dashboard",
        _ => "/"
    };

    public void Dispose()
    {
        EmergencyService.OnChange -= OnEmergencyChanged;
        OrderService.OnChange -= OnOrderChanged;
    }
}