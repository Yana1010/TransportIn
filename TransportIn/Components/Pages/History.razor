@page "/history"
@layout TransportIn.Components.Layout.AdminLayout
@rendermode InteractiveServer
@inject TransportIn.Services.AuthService AuthService
@inject TransportIn.Services.EmergencyService EmergencyService
@inject TransportIn.Services.OrderService OrderService
@inject TransportIn.Services.FleetService FleetService
@inject TransportIn.Services.ExpertRulesService ExpertRulesService
@inject TransportIn.Services.EmployeeService EmployeeService
@inject NavigationManager Navigation

<div class="admin-layout">
    <aside class="admin-sidebar">
        <div class="sidebar-header">
            <h4><i class="bi bi-truck-front-fill"></i> TransportIn</h4>
            <small>Диспетчерський пульт</small>
        </div>
        <nav class="mt-3">
            @if (AuthService.CurrentUser?.Role == TransportIn.Models.UserRole.Admin)
            {
                <a class="nav-link @(IsActive("/admin-dashboard") ? "active" : "")" href="/admin-dashboard"><i class="bi bi-grid-1x2-fill"></i> Панель адміна</a>
            }
            @if (AuthService.CurrentUser?.Role == TransportIn.Models.UserRole.Manager)
            {
                <a class="nav-link @(IsActive("/manager-dashboard") ? "active" : "")" href="/manager-dashboard"><i class="bi bi-people-fill"></i> Менеджер</a>
            }
            @if (AuthService.CurrentUser?.Role == TransportIn.Models.UserRole.Driver)
            {
                <a class="nav-link @(IsActive("/driver-dashboard") ? "active" : "")" href="/driver-dashboard"><i class="bi bi-person-badge-fill"></i> Водій</a>
            }
            <a class="nav-link @(IsActive("/map-monitor") ? "active" : "")" href="/map-monitor"><i class="bi bi-map"></i> Карта моніторингу</a>
            @if (AuthService.CurrentUser?.Role != TransportIn.Models.UserRole.Driver)
            {
                <a class="nav-link @(IsActive("/history") ? "active" : "")" href="/history"><i class="bi bi-clock-history"></i> Історія</a>
            }
            <a class="nav-link @(IsActive("/counter") ? "active" : "")" href="/counter"><i class="bi bi-graph-up-arrow"></i> Аналітика</a>
        </nav>
    </aside>

    <main class="admin-main">
        <div class="top-navbar">
            <div>
                <h5 class="mb-0" style="font-weight:600;color:var(--text-primary);">Історія та архіви</h5>
                <small style="color:var(--text-secondary);">Замовлення, події та застосування правил</small>
            </div>
            <div class="user-info">
                <div class="text-end d-none d-sm-block">
                    <div class="user-name">@AuthService.CurrentUser?.FullName</div>
                    <div class="user-role">@AuthService.CurrentUser?.Role</div>
                </div>
                <div class="user-avatar">@GetInitials(AuthService.CurrentUser?.FullName)</div>
            </div>
        </div>

        <div class="content-section">
            <!-- ВКЛАДКИ -->
            <div class="history-tabs">
                <button class="history-tab @(activeTab == "orders" ? "active" : "")" @onclick='() => activeTab = "orders"'>
                    <i class="bi bi-archive"></i> Історія замовлень
                    <span class="tab-count">@filteredOrders.Count</span>
                </button>
                <button class="history-tab @(activeTab == "events" ? "active" : "")" @onclick='() => activeTab = "events"'>
                    <i class="bi bi-activity"></i> Журнал подій
                    <span class="tab-count">@filteredEvents.Count</span>
                </button>
                <button class="history-tab @(activeTab == "rules" ? "active" : "")" @onclick='() => activeTab = "rules"'>
                    <i class="bi bi-brain"></i> Застосування правил
                    <span class="tab-count">@filteredRules.Count</span>
                </button>
            </div>

            <!-- ==================== ІСТОРІЯ ЗАМОВЛЕНЬ ==================== -->
            @if (activeTab == "orders")
            {
                <div class="modern-card">
                    <div class="card-body-custom">
                        <!-- ФІЛЬТРИ -->
                        <div class="filter-bar">
                            <div class="filter-group">
                                <label>Дата від</label>
                                <input type="text" class="dark-input" @bind="orderFilter.DateFrom" placeholder="ДД.ММ.РРРР" />
                            </div>
                            <div class="filter-group">
                                <label>Дата до</label>
                                <input type="text" class="dark-input" @bind="orderFilter.DateTo" placeholder="ДД.ММ.РРРР" />
                            </div>
                            <div class="filter-group">
                                <label>Статус</label>
                                <select class="dark-input" @bind="orderFilter.Status">
                                    <option value="">Всі статуси</option>
                                    <option value="Завершено">Завершено</option>
                                    <option value="Скасовано">Скасовано</option>
                                    <option value="В роботі">В роботі</option>
                                    <option value="Призупинено">Призупинено</option>
                                </select>
                            </div>
                            <div class="filter-group">
                                <label>Водій</label>
                                <select class="dark-input" @bind="orderFilter.Driver">
                                    <option value="">Всі водії</option>
                                    @foreach (var d in allDrivers)
                                    {
                                        <option value="@d">@d</option>
                                    }
                                </select>
                            </div>
                            <button class="btn-filter-reset" @onclick="ResetOrderFilter"><i class="bi bi-arrow-counterclockwise"></i> Скинути</button>
                        </div>

                        @if (filteredOrders.Count == 0)
                        {
                            <div class="empty-history">
                                <i class="bi bi-archive"></i>
                                <h4>Немає замовлень за обраними фільтрами</h4>
                                <p>Спробуйте змінити параметри пошуку</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="modern-table">
                                    <thead>
                                        <tr>
                                            <th>№</th>
                                            <th>Дата</th>
                                            <th>Замовник</th>
                                            <th>Вантаж</th>
                                            <th>Маршрут</th>
                                            <th>Водій</th>
                                            <th>ТЗ</th>
                                            <th>Статус</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var o in filteredOrders)
                                        {
                                            <tr class="history-table-row">
                                                <td><span class="history-id">#@o.Id</span></td>
                                                <td><span class="history-date">@o.Date</span></td>
                                                <td>
                                                    <div style="font-weight:600;color:var(--text-primary)">@o.CustomerCompany</div>
                                                    <div style="font-size:.78rem;color:var(--text-secondary)">@o.CustomerName</div>
                                                </td>
                                                <td>@o.CargoName<br><span style="font-size:.78rem;color:var(--text-secondary)">@o.WeightTons т · @o.VolumeM3 м³</span></td>
                                                <td style="font-size:.82rem">
                                                    <i class="bi bi-geo-alt-fill" style="color:var(--primary-blue)"></i> @o.LoadingPoint<br>
                                                    <i class="bi bi-flag-fill" style="color:var(--success-green)"></i> @o.DeliveryPoint
                                                </td>
                                                <td>
                                                    <span class="history-driver">
                                                        <i class="bi bi-person-badge"></i> @(string.IsNullOrEmpty(o.Driver) ? "—" : o.Driver)
                                                    </span>
                                                </td>
                                                <td><span class="code-text">@o.VehiclePlate</span></td>
                                                <td><span class="status-badge @OrderStatusClass(o.Status)">@o.Status</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- ==================== ЖУРНАЛ ПОДІЙ ==================== -->
            @if (activeTab == "events")
            {
                <div class="modern-card">
                    <div class="card-body-custom">
                        <div class="filter-bar">
                            <div class="filter-group">
                                <label>Тип події</label>
                                <select class="dark-input" @bind="eventFilter.Type">
                                    <option value="">Всі типи</option>
                                    <option value="threat">Загрози</option>
                                    <option value="status">Зміни статусів</option>
                                    <option value="msg">Повідомлення</option>
                                </select>
                            </div>
                            <div class="filter-group">
                                <label>Пошук</label>
                                <input type="text" class="dark-input" @bind="eventFilter.Search" placeholder="Ключове слово..." />
                            </div>
                            <button class="btn-filter-reset" @onclick="ResetEventFilter"><i class="bi bi-arrow-counterclockwise"></i> Скинути</button>
                        </div>

                        @if (filteredEvents.Count == 0)
                        {
                            <div class="empty-history">
                                <i class="bi bi-activity"></i>
                                <h4>Подій не знайдено</h4>
                            </div>
                        }
                        else
                        {
                            <div class="event-timeline">
                                @foreach (var ev in filteredEvents)
                                {
                                    <div class="event-item @ev.Type">
                                        <div class="event-time">@ev.Time</div>
                                        <div class="event-title">
                                            <span class="event-tag @ev.Type">@ev.TypeLabel</span>
                                            @ev.Title
                                        </div>
                                        <div class="event-desc">@ev.Description</div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- ==================== ЗАСТОСУВАННЯ ПРАВИЛ ==================== -->
            @if (activeTab == "rules")
            {
                <div class="modern-card">
                    <div class="card-body-custom">
                        @if (filteredRules.Count == 0)
                        {
                            <div class="empty-history">
                                <i class="bi bi-brain"></i>
                                <h4>Правила ще не застосовувались</h4>
                                <p>Історія застосування експертних правил буде з'являтися тут автоматично при виникненні загроз</p>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="modern-table">
                                    <thead>
                                        <tr>
                                            <th>Час</th>
                                            <th>Загроза</th>
                                            <th>Спрацювало правило</th>
                                            <th>Рекомендація</th>
                                            <th>Об'єкт</th>
                                            <th>Результат</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in filteredRules)
                                        {
                                            <tr class="history-table-row">
                                                <td><span class="history-date">@r.Time</span></td>
                                                <td><strong>@r.Threat</strong></td>
                                                <td>@r.RuleName</td>
                                                <td style="font-size:.85rem">@r.Recommendation</td>
                                                <td>
                                                    <span class="history-driver">
                                                        <i class="bi bi-truck"></i> @r.Target
                                                    </span>
                                                </td>
                                                <td><span class="status-badge @(r.Result == "Виконано" ? "completed" : "suspended")">@r.Result</span></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </main>
</div>

@code {
    private string activeTab = "orders";

    // ===== МОДЕЛІ =====
    private class OrderHistoryVM
    {
        public int Id; public string Date = ""; public string CustomerCompany = ""; public string CustomerName = "";
        public string CargoName = ""; public double WeightTons; public double VolumeM3;
        public string LoadingPoint = ""; public string DeliveryPoint = "";
        public string Driver = ""; public string VehiclePlate = ""; public string Status = "";
    }
    private class EventVM
    {
        public string Time = ""; public string Type = ""; public string TypeLabel = "";
        public string Title = ""; public string Description = "";
    }
    private class RuleHistoryVM
    {
        public string Time = ""; public string Threat = ""; public string RuleName = "";
        public string Recommendation = ""; public string Target = ""; public string Result = "";
    }

    // ===== ФІЛЬТРИ =====
    private class OrderFilter { public string DateFrom = ""; public string DateTo = ""; public string Status = ""; public string Driver = ""; }
    private class EventFilter { public string Type = ""; public string Search = ""; }

    private OrderFilter orderFilter = new();
    private EventFilter eventFilter = new();

    // ===== ЗАГУШКИ ДАНИХ =====
    private List<OrderHistoryVM> allOrders = new();
    private List<EventVM> allEvents = new();
    private List<RuleHistoryVM> allRules = new();
    private List<string> allDrivers = new() { "Коваленко І. П.", "Бондар В. М.", "Шевченко О. О.", "Мельник Д. С." };

    protected override void OnInitialized()
    {
        // ===== 1. ПЕРЕВІРКА РОЛІ =====
        if (AuthService.CurrentUser?.Role == TransportIn.Models.UserRole.Driver)
        {
            Navigation.NavigateTo("/driver-dashboard");
            return;
        }

        // Заглушка історії замовлень
        allOrders = new()
        {
            new() { Id = 1042, Date = "15.11.2026 09:15", CustomerCompany = "ТОВ «ФудМаркет»", CustomerName = "Петренко О. В.", CargoName = "Продукти охолоджені", WeightTons = 2.5, VolumeM3 = 12, LoadingPoint = "вул. Промислова, 15", DeliveryPoint = "вул. Хрещатик, 22", Driver = "Коваленко І. П.", VehiclePlate = "AA 1234 BP", Status = "В роботі" },
            new() { Id = 1041, Date = "14.11.2026 14:30", CustomerCompany = "ПАТ «БудМатеріали»", CustomerName = "Сидоренко І. М.", CargoName = "Цегла керамічна", WeightTons = 18, VolumeM3 = 24, LoadingPoint = "вул. Заводська, 8", DeliveryPoint = "просп. Перемоги, 100", Driver = "Бондар В. М.", VehiclePlate = "AI 5678 CE", Status = "Завершено" },
            new() { Id = 1040, Date = "14.11.2026 08:00", CustomerCompany = "ТОВ «ФармЛайн»", CustomerName = "Ковальчук Т. П.", CargoName = "Медикаменти", WeightTons = 1.2, VolumeM3 = 8, LoadingPoint = "вул. Медична, 3", DeliveryPoint = "вул. Аптечна, 12", Driver = "Шевченко О. О.", VehiclePlate = "BC 0912 AK", Status = "Завершено" },
            new() { Id = 1039, Date = "13.11.2026 16:45", CustomerCompany = "ФОП Мельник", CustomerName = "Мельник Д. С.", CargoName = "Меблі", WeightTons = 4.5, VolumeM3 = 32, LoadingPoint = "вул. Меблева, 22", DeliveryPoint = "вул. Нова, 5", Driver = "Коваленко І. П.", VehiclePlate = "AA 1234 BP", Status = "Скасовано" },
            new() { Id = 1038, Date = "12.11.2026 11:20", CustomerCompany = "ТОВ «АгроТрейд»", CustomerName = "Литвин О. І.", CargoName = "Зерно", WeightTons = 20, VolumeM3 = 45, LoadingPoint = "с. Зернове, склад 1", DeliveryPoint = "вул. Портова, 7", Driver = "Бондар В. М.", VehiclePlate = "AI 5678 CE", Status = "Завершено" },
            new() { Id = 1037, Date = "11.11.2026 09:00", CustomerCompany = "ТОВ «ЕкоПродукт»", CustomerName = "Грищенко Н. В.", CargoName = "Овочі (рефрижератор)", WeightTons = 3.8, VolumeM3 = 18, LoadingPoint = "с. Городнє", DeliveryPoint = "вул. Ринкова, 1", Driver = "Шевченко О. О.", VehiclePlate = "BC 0912 AK", Status = "Призупинено" },
        };

        // Заглушка журналу подій
        allEvents = new()
        {
            new() { Time = "15.11.2026 14:32", Type = "threat", TypeLabel = "ЗАГРОЗА", Title = "Активовано повітряну тривогу", Description = "Адміністратор активував тестову повітряну тривогу. 3 ТЗ в дорозі отримали попередження." },
            new() { Time = "15.11.2026 14:35", Type = "rule", TypeLabel = "ПРАВИЛО", Title = "Спрацювало правило «Повітряна тривога — ТЗ в дорозі»", Description = "Система автоматично побудувала маршрут до найближчої безпечної стоянки для ТЗ AA 1234 BP." },
            new() { Time = "15.11.2026 15:10", Type = "msg", TypeLabel = "ПОВІДОМЛЕННЯ", Title = "Повідомлення від Бондар В. М.", Description = "Клієнт не виходить на зв'язок на пункті доставки №2. Менеджеру надіслано запит." },
            new() { Time = "15.11.2026 11:45", Type = "status", TypeLabel = "СТАТУС", Title = "Замовлення №1041 завершено", Description = "Водій Бондар В. М. підтвердив доставку вантажу «Цегла керамічна»." },
            new() { Time = "14.11.2026 16:20", Type = "threat", TypeLabel = "ЗАГРОЗА", Title = "Перекриття мосту Патона", Description = "Адміністратор позначив міст Патона як недоступний. 2 маршрути перераховано." },
            new() { Time = "14.11.2026 16:22", Type = "rule", TypeLabel = "ПРАВИЛО", Title = "Спрацювало правило «Перекриття мосту»", Description = "Автоматично побудовано альтернативний маршрут через міст Північний для ТЗ BC 0912 AK." },
            new() { Time = "14.11.2026 09:15", Type = "status", TypeLabel = "СТАТУС", Title = "Призначено водія Коваленко І. П. на замовлення №1042", Description = "Менеджер призначив водія та ТЗ AA 1234 BP." },
            new() { Time = "13.11.2026 17:00", Type = "status", TypeLabel = "СТАТУС", Title = "Замовлення №1039 скасовано", Description = "Менеджер скасував замовлення за запитом клієнта." },
            new() { Time = "13.11.2026 11:30", Type = "msg", TypeLabel = "ПОВІДОМЛЕННЯ", Title = "Повідомлення від Шевченко О. О.", Description = "Технічна несправність: загорівся індикатор тиску масла. Адміністратору надіслано запит." },
        };

        // Заглушка застосування правил
        allRules = new()
        {
            new() { Time = "15.11.2026 14:35", Threat = "Повітряна тривога", RuleName = "Повітряна тривога — ТЗ в дорозі", Recommendation = "Рух до найближчої безпечної стоянки", Target = "AA 1234 BP (Коваленко І. П.)", Result = "Виконано" },
            new() { Time = "14.11.2026 16:22", Threat = "Перекриття мосту", RuleName = "Перекриття мосту — альтернативний маршрут", Recommendation = "Побудова маршруту через інший міст", Target = "BC 0912 AK (Шевченко О. О.)", Result = "Виконано" },
            new() { Time = "12.11.2026 08:15", Threat = "Ожеледиця", RuleName = "Ожеледиця — зменшення швидкості", Recommendation = "Зменшити швидкість на 30-50%, збільшити час доставки", Target = "AI 5678 CE (Бондар В. М.)", Result = "Виконано" },
            new() { Time = "11.11.2026 10:00", Threat = "Повітряна тривога", RuleName = "Повітряна тривога — ТЗ на пункті", Recommendation = "Блокування виїзду до завершення тривоги", Target = "AB 4455 MN (Мельник Д. С.)", Result = "Виконано" },
        };
    }

    // ===== ФІЛЬТРАЦІЯ =====
    private List<OrderHistoryVM> filteredOrders
    {
        get
        {
            var list = allOrders.AsEnumerable();
            if (!string.IsNullOrEmpty(orderFilter.Status))
                list = list.Where(o => o.Status == orderFilter.Status);
            if (!string.IsNullOrEmpty(orderFilter.Driver))
                list = list.Where(o => o.Driver == orderFilter.Driver);

            if (!string.IsNullOrEmpty(orderFilter.DateFrom))
                list = list.Where(o => ParseDate(o.Date) >= ParseDate(orderFilter.DateFrom));
            if (!string.IsNullOrEmpty(orderFilter.DateTo))
                list = list.Where(o => ParseDate(o.Date) <= ParseDate(orderFilter.DateTo) + TimeSpan.FromDays(1));

            return list.ToList();
        }
    }

    private List<EventVM> filteredEvents
    {
        get
        {
            var list = allEvents.AsEnumerable();
            if (!string.IsNullOrEmpty(eventFilter.Type))
                list = list.Where(e => e.Type == eventFilter.Type);
            if (!string.IsNullOrEmpty(eventFilter.Search))
            {
                var s = eventFilter.Search.ToLower();
                list = list.Where(e => e.Title.ToLower().Contains(s) || e.Description.ToLower().Contains(s));
            }
            return list.ToList();
        }
    }

    private List<RuleHistoryVM> filteredRules => allRules;

    private DateTime ParseDate(string s)
    {
        if (DateTime.TryParse(s, out var d)) return d;
        if (DateTime.TryParseExact(s, "dd.MM.yyyy", null, System.Globalization.DateTimeStyles.None, out d)) return d;
        return DateTime.MinValue;
    }

    private void ResetOrderFilter() { orderFilter = new OrderFilter(); }
    private void ResetEventFilter() { eventFilter = new EventFilter(); }

    private string OrderStatusClass(string s) => s switch
    {
        "Завершено" => "completed",
        "Скасовано" => "cancelled",
        "В роботі" => "in-progress",
        "Призупинено" => "suspended",
        _ => "new"
    };

    private string GetInitials(string? n) { if (string.IsNullOrWhiteSpace(n)) return "?"; var p = n.Split(' ', StringSplitOptions.RemoveEmptyEntries); return p.Length >= 2 ? $"{p[0][0]}{p[1][0]}".ToUpper() : n[..Math.Min(2, n.Length)].ToUpper(); }

    private bool IsActive(string path) => Navigation.Uri.EndsWith(path, StringComparison.OrdinalIgnoreCase);
}